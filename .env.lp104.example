# LP104 remains disabled until the owner approves Google Maps Platform billing and terms.
# Set only as Supabase Edge Function secrets; never place values in browser configuration.
GRIDLY_AUTHORITATIVE_RURAL_PROVIDER=google
GRIDLY_AUTHORITATIVE_RURAL_API_KEY=replace-in-supabase-secret-store
GRIDLY_AUTHORITATIVE_RURAL_URL=https://maps.googleapis.com/maps/api/geocode/json
GRIDLY_AUTHORITATIVE_RURAL_TIMEOUT_MS=6500
# Rotate this whenever provider policy or canonicalization changes.
GRIDLY_GEOCODE_CACHE_NAMESPACE=lp104-google-rural-v1
GRIDLY_RURAL_FALLBACK_ENABLED=true
