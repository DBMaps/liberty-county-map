{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridly.example/schemas/community-package-identity-contract-v1.json",
  "title": "Gridly Community Package Identity Contract v1",
  "description": "Additive, manufacturing-only identity layer. Legacy communities string arrays remain the runtime compatibility projection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "county", "censusPlaces", "legacyAwarenessAreas", "communities"],
  "properties": {
    "schemaVersion": { "const": "gridly.community-package.identity.v1" },
    "county": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countyFips", "displayName"],
      "properties": {
        "countyFips": { "type": "string", "pattern": "^48[0-9]{3}$" },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "censusPlaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/censusPlace" }
    },
    "legacyAwarenessAreas": {
      "type": "array",
      "items": { "$ref": "#/$defs/legacyArea" }
    },
    "communities": {
      "description": "Unchanged string-only projection consumed by legacy package/runtime paths. It is display compatibility, never governed identity.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "censusPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identitySource", "placeGeoid", "displayName", "governedType", "includedInCensusFoundation", "consumerEligible", "countyMemberships"],
      "properties": {
        "identitySource": { "const": "CENSUS_PLACE" },
        "placeGeoid": { "type": "string", "pattern": "^48[0-9]{5}$" },
        "displayName": { "type": "string", "minLength": 1 },
        "governedType": {
          "enum": ["INCORPORATED_PLACE", "CENSUS_DESIGNATED_PLACE", "INACTIVE_OR_NONFUNCTIONING_INCORPORATED_PLACE"]
        },
        "includedInCensusFoundation": { "const": true },
        "consumerEligible": { "type": "boolean" },
        "countyMemberships": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^48[0-9]{3}$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "governedType": { "const": "INACTIVE_OR_NONFUNCTIONING_INCORPORATED_PLACE" } } },
          "then": { "properties": { "consumerEligible": { "const": false } } }
        },
        {
          "if": { "properties": { "governedType": { "enum": ["INCORPORATED_PLACE", "CENSUS_DESIGNATED_PLACE"] } } },
          "then": { "properties": { "consumerEligible": { "const": true } } }
        }
      ]
    },
    "legacyArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identitySource", "legacyIdentity", "displayName", "consumerEligible"],
      "properties": {
        "identitySource": { "const": "LEGACY_NON_CENSUS" },
        "legacyIdentity": {
          "description": "Existing county-scoped runtime/package key. It is explicitly not a Census PLACE GEOID.",
          "type": "string",
          "minLength": 1
        },
        "displayName": { "type": "string", "minLength": 1 },
        "consumerEligible": { "type": "boolean" }
      }
    }
  }
}
