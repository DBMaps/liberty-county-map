# The hosting platform supplies SUPABASE_URL. Use only the isolated project.
GRIDLY_LABELS_PROJECT_REF=
GRIDLY_LABELS_PUBLIC_ORIGIN=
GRIDLY_LABELS_PILOT_ENABLED=false
GRIDLY_LABELS_ESRI_ENABLED=false

# Set through the platform's secret store only; never commit populated values.
GRIDLY_LABELS_DATABASE_URL=
GRIDLY_LABELS_DATABASE_CA_PEM=
GRIDLY_LABELS_INGRESS_KEY=
GRIDLY_LABELS_ESRI_CLIENT_ID=
GRIDLY_LABELS_ESRI_CLIENT_SECRET=

GRIDLY_LABELS_TIMEOUT_MS=6000
GRIDLY_LABELS_TOKEN_TIMEOUT_MS=2000
GRIDLY_LABELS_TILE_TIMEOUT_MS=3000
GRIDLY_LABELS_REFRESH_INTERVAL_MS=5000
GRIDLY_LABELS_MAX_IN_FLIGHT=32
GRIDLY_LABELS_MAX_TILE_BYTES=524288
